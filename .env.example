# GameWatch Cloudflare D1 Database Configuration (100% Free Forever)
# =====================================================================
# Get these in your Cloudflare Dashboard (dash.cloudflare.com):
# 1. Account ID: Found in your Cloudflare dashboard URL or Workers & Pages overview.
# 2. Database ID: Found under Workers & Pages > D1 SQL Database > gamewatch-db.
# 3. API Token: Created under My Profile > API Tokens (with 'D1: Edit' permission).

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Set to true if you want direct query execution over HTTP (defaults to hybrid fast-cache mode)
# CLOUDFLARE_D1_DIRECT=false
